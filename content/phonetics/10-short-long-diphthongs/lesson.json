  "quiz": [
    {
      "id": "q1",
      "type": "text",
      "q": {
        "vi": "Viết phiên âm của từ \"seat\".",
        "en": "Write the transcription of \"seat\"."
      },
      "answers": [
        "siːt"
      ],
      "explain": {
        "vi": "seat có nguyên âm dài /iː/: /siːt/.",
        "en": "seat has the long vowel /iː/: /siːt/."
      }
    },
    {
      "id": "q2",
      "type": "text",
      "q": {
        "vi": "Viết phiên âm của từ \"sit\".",
        "en": "Write the transcription of \"sit\"."
      },
      "answers": [
        "sɪt"
      ],
      "explain": {
        "vi": "sit có nguyên âm ngắn /ɪ/: /sɪt/.",
        "en": "sit has the short vowel /ɪ/: /sɪt/."
      }
    },
    {
